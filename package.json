{
  "name": "book-editor",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:worker": "pnpm --filter api worker",
    "dev:chatbot": "pnpm --filter chatbot dev",
    "dev:chatbot-worker": "pnpm --filter chatbot worker",
    "dev:chatbot-ingest-worker": "pnpm --filter chatbot ingest-worker",
    "dev:embed": "apps\\embedding-svc\\venv\\Scripts\\python.exe -m uvicorn main:app --reload --port 5558 --app-dir apps/embedding-svc",
    "ingest:backfill": "pnpm --filter chatbot backfill",
    "ingest:pull-conversations": "pnpm --filter chatbot pull-conversations",
    "chatbot:seed": "pnpm --filter chatbot seed",
    "prisma:studio": "pnpm --filter api prisma:studio",
    "prisma:clear": "pnpm --filter api prisma:reset",
    "prisma:studio:chatbot": "pnpm --filter chatbot prisma:studio",
    "prisma:migrate:chatbot": "pnpm --filter chatbot prisma:migrate",
    "format": "prettier --write \"**/*.{js,ts,jsx,tsx,css,html}\"",
    "infra": "docker compose up -d",
    "redis": "docker compose up -d",
    "setup": "pnpm infra && pnpm --filter api prisma:migrate && pnpm prisma:migrate:chatbot",
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:worker\"",
    "dev:all": "concurrently \"pnpm dev:web\" \"pnpm dev:api\" \"pnpm dev:worker\" \"pnpm dev:chatbot\" \"pnpm dev:chatbot-worker\" \"pnpm dev:chatbot-ingest-worker\" \"pnpm dev:embed\"",
    "build": "pnpm --filter web build",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js --env production",
    "pm2:reload": "pm2 reload ecosystem.config.js --env production",
    "pm2:delete": "pm2 delete ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "pm2:status": "pm2 status"
  },
  "devDependencies": {
    "concurrently": "latest",
    "prettier": "^3.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "msgpackr-extract",
      "prisma",
      "sharp"
    ]
  }
}
